# Release and image coordinates. Do not use latest in a release.
PMS_VERSION=1.0.6
PMS_FRONTEND_IMAGE=ghcr.io/xiebinjava/pms-front
PMS_BACKEND_IMAGE=ghcr.io/xiebinjava/pms-backend
PMS_PORT=5173
# Docker Desktop / Colima should have at least this much memory allocated.
PMS_MIN_DOCKER_MEMORY_GIB=2

# MySQL 8 bootstrap. bootstrap.sh replaces placeholder passwords.
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_USER=pms
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_DB=pms

# Application bootstrap. bootstrap.sh replaces JWT / MySQL placeholders only.
# The admin password below is the documented first-login default (change after login).
PMS_JWT_SECRET=change-me-generate-a-random-secret
PMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PMS_BOOTSTRAP_ADMIN_USERNAME=admin
PMS_BOOTSTRAP_ADMIN_NAME_ZH=系统管理员
PMS_BOOTSTRAP_ADMIN_PASSWORD=PmsAdmin123!
PMS_DEPLOYMENT_ENV=development
PMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PMS_PUBLIC_BASE_URL=http://localhost:5173

# Local storage defaults. Configure S3-compatible storage separately for production.
PMS_STORAGE_TYPE=local
PMS_UPLOAD_QUOTA_BYTES=524288000
PMS_UPLOAD_DIR=/var/lib/pms/uploads

# Notifications are off for the local quick start.
PMS_MAIL_ENABLED=false
PMS_NOTIFICATION_STARTUP_CHECK=false
PMS_NOTIFICATION_TASK_REMINDER_ENABLED=false
PMS_PASSWORD_RESET_EXPOSE_TOKEN=true
PMS_INVITATION_EXPOSE_TOKEN=true
